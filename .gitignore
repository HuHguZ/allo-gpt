# Publish only the application, tests, setup scripts and reviewed documentation.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/package.json
!/package-lock.json
!/tsconfig.json
!/compose.yaml
!/start.bat
!/start.cmd
!/src/
!/test/
!/scripts/
!/infra/
!/docs/

# Private runtime data and credentials, including files nested in allowed folders.
**/node_modules/
**/dist/
**/runtime/
**/work/
**/calls/
**/recordings/
**/.env
**/.env.*
**/.envrc
**/*.conf
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.session*
**/*.log
**/*.tmp
**/*.bak
**/*.wav
**/*.mp3
**/*.pcm
**/*.ogg
**/*.flac
**/*.m4a
**/*.aac
**/.DS_Store
**/Thumbs.db

# Empty, reviewed configuration template is intentionally public.
!/.env.example
