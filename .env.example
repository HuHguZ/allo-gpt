# Start in demo mode. Demo never contacts OpenAI, Plusofon, or Telegram.
PHONE_MODE=demo

# Required for real calls. Set the project API key locally; do not send it to logs.
OPENAI_API_KEY=
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_BACKEND_MODEL=gpt-6-luna
OPENAI_VOICE=marin
PLUSOFON_API_TOKEN=
OPENAI_WEB_SEARCH=true

# Asterisk on this computer, WSL, or a private server. API credentials are our own.
ASTERISK_ARI_URL=http://127.0.0.1:8088
ASTERISK_ARI_USERNAME=phone
ASTERISK_ARI_PASSWORD=
ASTERISK_APP=gpt-live-phone
ASTERISK_TRUNK=plusofon
# Container listens internally on all interfaces; Compose exposes ARI only on localhost.
ASTERISK_HTTP_BIND_ADDRESS=0.0.0.0

# From Plusofon > SIP accounts. These are SIP credentials, not an API key.
PLUSOFON_SIP_HOST=
PLUSOFON_SIP_USERNAME=
PLUSOFON_SIP_PASSWORD=
PLUSOFON_CALLER_NUMBER=
# Public address of the Asterisk host, only when it is behind NAT.
ASTERISK_EXTERNAL_ADDRESS=
# Incoming speech detection for immediate interruption; raise threshold for noisy lines.
ASTERISK_TALKING_THRESHOLD=256
ASTERISK_TALKING_SILENCE_MS=250
# Fixed incoming RTP buffer. Larger values tolerate jitter but increase speech delay.
ASTERISK_JITTERBUFFER_MS=120

# No batch dialer or automatic retries. One call at a time.
# 0 disables the application duration timer. Optional finite limit: 10–3600 seconds.
MAX_CALL_SECONDS=0
# Optional comma-separated E.164 allowlist for incoming AND outgoing calls.
# Empty allows manually entered +7 outgoing numbers and any incoming caller.
ALLOWED_NUMBERS=
CALLS_DIR=./calls

# Optional: only used when you explicitly choose to send a saved transcript.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
